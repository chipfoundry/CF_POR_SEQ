        pg_pin(vpwr)   { 
        voltage_name  :  vpwr; 
	pg_type : primary_power;
/*	capacitance : 21.5 ;
*/
        } 
        pg_pin(vgnd)   { 
        voltage_name  :  vgnd; 
	pg_type : primary_ground;
/*	capacitance : 713.5 ;
*/
        } 
        leakage_power(){
	  when : "en_l" ;
          value : "0.0002"; 
        } 
        leakage_power(){
	  when : "!en_l" ;
	  value : "16.5" ;
        } 
    }
