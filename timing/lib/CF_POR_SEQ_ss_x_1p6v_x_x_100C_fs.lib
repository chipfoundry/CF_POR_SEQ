        pg_pin(vpwr)   { 
        voltage_name  :  vpwr; 
	pg_type : primary_power;
/*	capacitance : 23.5;
*/
        } 

        pg_pin(vgnd)   { 
        voltage_name  :  vgnd; 
	pg_type : primary_ground;
/*	capacitance : 699.5;
*/
	} 
        leakage_power(){
	  when : "en_l" ;
          value : "0.000008"; 
        } 
        leakage_power(){
	  when : "!en_l" ;
	  value : "4.3" ;
        } 
    }
